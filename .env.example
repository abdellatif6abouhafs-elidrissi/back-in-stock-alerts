# Copy to .env and load it (e.g. `node --env-file=.env src/server.js`, or `npm start` with the shell env set).

PORT=3000
DATA_DIR=./data

# Stock API: GET {STOCK_API_URL}/{sku}  and  GET {STOCK_API_URL}
STOCK_API_URL=http://localhost:4000/api/stock
STOCK_API_KEY=dev-stock-key

# Email provider (Resend-compatible). Always called at {RESEND_BASE_URL}/emails
RESEND_API_KEY=dev-resend-key
RESEND_BASE_URL=http://localhost:4000/resend

# Incoming webhooks must carry header x-webhook-secret
WEBHOOK_SECRET=dev-webhook-secret

ADMIN_PASSWORD=admin
FROM_EMAIL=alerts@example.com
STORE_NAME=The Store
# Optional: link for the "Shop now" button in the email (button omitted when empty)
STORE_URL=
POLL_INTERVAL_SECONDS=60
# Optional: per-IP limit for POST /api/requests
RATE_LIMIT_PER_MIN=30
